{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resources",
  "type": "object",
  "required": ["resources"],
  "properties": {
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "spendable", "description"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "type": "string" },
          "spendable": { "type": "boolean" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
