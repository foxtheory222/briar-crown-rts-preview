{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Squads",
  "type": "object",
  "required": ["squads"],
  "properties": {
    "squads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "faction", "unitId", "size", "costs", "housing", "moraleProfile", "commands", "icon", "trainSeconds", "mapPresentation"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "faction": { "type": "string" },
          "unitId": { "type": "string" },
          "size": { "type": "number" },
          "costs": { "type": "object" },
          "housing": { "type": "number" },
          "moraleProfile": { "type": "string" },
          "commands": { "type": "array", "items": { "type": "string" } },
          "icon": { "type": "string" },
          "trainSeconds": { "type": "number" },
          "mapPresentation": {
            "type": "object",
            "required": ["silhouette", "emblem", "accent"],
            "properties": {
              "silhouette": { "type": "string" },
              "emblem": { "type": "string" },
              "accent": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
