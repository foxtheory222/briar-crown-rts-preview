{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Objectives",
  "type": "object",
  "required": ["objectives"],
  "properties": {
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "reward", "captureSeconds", "tickSeconds", "icon", "mapPresentation"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "reward": { "type": "object" },
          "captureSeconds": { "type": "number" },
          "tickSeconds": { "type": "number" },
          "icon": { "type": "string" },
          "mapPresentation": {
            "type": "object",
            "required": ["silhouette", "emblem", "accent"],
            "properties": {
              "silhouette": { "type": "string" },
              "emblem": { "type": "string" },
              "accent": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
