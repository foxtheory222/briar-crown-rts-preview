{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Units",
  "type": "object",
  "required": ["units"],
  "properties": {
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "faction", "role", "health", "damage", "damageClass", "armorClass", "icon"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "faction": { "type": "string" },
          "role": { "type": "string" },
          "health": { "type": "number" },
          "damage": { "type": "number" },
          "damageClass": { "type": "string" },
          "armorClass": { "type": "string" },
          "icon": { "type": "string" }
        }
      }
    }
  }
}
