{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Abilities",
  "type": "object",
  "required": ["abilities"],
  "properties": {
    "abilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "faction", "effect", "icon"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "type": "string" },
          "faction": { "type": "string" },
          "effect": { "type": "string" },
          "icon": { "type": "string" }
        }
      }
    }
  }
}
