{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Maps",
  "type": "object",
  "required": ["maps"],
  "properties": {
    "maps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "biomeId", "width", "height", "players", "objectiveIds", "objectivePositions", "lanes", "blocked", "terrainFeatures", "notes"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "biomeId": { "type": "string" },
          "width": { "type": "number" },
          "height": { "type": "number" },
          "players": { "type": "number" },
          "objectiveIds": { "type": "array", "items": { "type": "string" } },
          "objectivePositions": { "type": "object" },
          "lanes": { "type": "array", "items": { "type": "string" } },
          "blocked": { "type": "array" },
          "terrainFeatures": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "kind", "x", "y", "w", "h", "palette"],
              "properties": {
                "id": { "type": "string" },
                "kind": { "type": "string" },
                "x": { "type": "number" },
                "y": { "type": "number" },
                "w": { "type": "number" },
                "h": { "type": "number" },
                "palette": { "type": "string" }
              }
            }
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
