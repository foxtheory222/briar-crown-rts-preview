{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heroes",
  "type": "object",
  "required": ["heroes"],
  "properties": {
    "heroes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "faction", "role", "abilityIds", "xpToLevel", "icon"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "faction": { "type": "string" },
          "role": { "type": "string" },
          "abilityIds": { "type": "array", "items": { "type": "string" } },
          "xpToLevel": { "type": "array", "items": { "type": "number" } },
          "icon": { "type": "string" }
        }
      }
    }
  }
}
