{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Morale",
  "type": "object",
  "required": ["morale"],
  "properties": {
    "morale": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "steadyAt", "shakenAt", "lossPenalty", "flankedPenalty", "heroDeathPenalty", "fearPenalty", "bombardmentPenalty"],
        "properties": {
          "id": { "type": "string" },
          "steadyAt": { "type": "number" },
          "shakenAt": { "type": "number" },
          "lossPenalty": { "type": "number" },
          "flankedPenalty": { "type": "number" },
          "heroDeathPenalty": { "type": "number" },
          "fearPenalty": { "type": "number" },
          "bombardmentPenalty": { "type": "number" }
        }
      }
    }
  }
}
