{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Simulation",
  "type": "object",
  "required": ["simulation"],
  "properties": {
    "simulation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "movementSpeeds", "combatRanges", "structureAttackMinRange", "tacticalOrders"],
        "properties": {
          "id": { "type": "string" },
          "movementSpeeds": {
            "type": "object",
            "required": ["default", "capture", "retreat"],
            "properties": {
              "default": { "type": "number" },
              "capture": { "type": "number" },
              "retreat": { "type": "number" }
            }
          },
          "combatRanges": {
            "type": "object",
            "required": ["default", "ranged", "caster", "siege"],
            "properties": {
              "default": { "type": "number" },
              "ranged": { "type": "number" },
              "caster": { "type": "number" },
              "siege": { "type": "number" }
            }
          },
          "structureAttackMinRange": { "type": "number" },
          "tacticalOrders": {
            "type": "object",
            "required": ["stanceModes", "formations", "targetPriorities"],
            "properties": {
              "stanceModes": {
                "type": "array",
                "items": { "type": "string" }
              },
              "formations": {
                "type": "array",
                "items": { "type": "string" }
              },
              "targetPriorities": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
