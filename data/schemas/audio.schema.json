{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audio",
  "type": "object",
  "required": ["audio"],
  "properties": {
    "audio": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "license", "enginePackage", "cues"],
        "properties": {
          "id": { "type": "string" },
          "license": { "type": "string" },
          "enginePackage": { "type": "string" },
          "notes": { "type": "string" },
          "cues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "category", "engineAsset", "waveform", "frequency", "seconds", "gain"],
              "properties": {
                "id": { "type": "string" },
                "category": { "type": "string" },
                "engineAsset": { "type": "string" },
                "waveform": { "type": "string" },
                "frequency": { "type": "number" },
                "seconds": { "type": "number" },
                "gain": { "type": "number" }
              }
            }
          }
        }
      }
    }
  }
}
